{
  "extends": "@tsconfig/node20/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "experimentalDecorators": false,
    "useDefineForClassFields": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "strict": true,
    "noUnusedLocals": false,
    "types": ["node"]
  }
}
